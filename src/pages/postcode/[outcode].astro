---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { getAllOutcodesWithRelations } from '../../lib/geo';
import { getServicesByCategory } from '../../lib/services';
import type { OutcodeWithRelations } from '../../types/index';

export async function getStaticPaths() {
  const outcodes = await getAllOutcodesWithRelations();

  return outcodes.map((o) => ({
    params: { outcode: o.outcode.toLowerCase() },
    props:  { outcodeData: o },
  }));
}

interface Props {
  outcodeData: OutcodeWithRelations;
}

const { outcodeData } = Astro.props;
const { outcode, towns: town, counties: county } = outcodeData;

const pageTitle       = `Emergency Plumber ${outcode} | Local Plumbers in ${outcode} Postcode`;
const pageDescription = `Find your exclusive local plumber for the ${outcode} postcode area in ${town.name}, ${county.name}. One vetted Gas Safe specialist — direct connection, 24/7 emergency response.`;
const canonicalUrl    = `https://www.localplumber.co.uk/postcode/${outcode.toLowerCase()}`;

const localBusinessSchema = {
  "@context":    "https://schema.org",
  "@type":       "LocalBusiness",
  "name":        `LocalPlumber.co.uk — ${outcode}`,
  "description": pageDescription,
  "url":         canonicalUrl,
  "telephone":   "+448000000000",
  "areaServed": {
    "@type": "AdministrativeArea",
    "name":  outcode,
    "containedIn": {
      "@type": "City",
      "name":  town.name,
      "containedIn": {
        "@type": "AdministrativeArea",
        "name":  county.name
      }
    }
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type":    "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",       "item": "https://www.localplumber.co.uk" },
    { "@type": "ListItem", "position": 2, "name": county.name,  "item": `https://www.localplumber.co.uk/${county.slug}` },
    { "@type": "ListItem", "position": 3, "name": town.name,    "item": `https://www.localplumber.co.uk/${county.slug}/${town.slug}` },
    { "@type": "ListItem", "position": 4, "name": outcode,      "item": canonicalUrl }
  ]
};

const AREA_PHONE = '0800 000 0000';

const plumbingServices  = getServicesByCategory('Plumbing');
const heatingServices   = getServicesByCategory('Heating');
const drainServices     = getServicesByCategory('Drains');
const bathroomServices  = getServicesByCategory('Bathrooms');
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLdSchemas={[localBusinessSchema, breadcrumbSchema]}
  locationName={outcode}
>

  <!-- Breadcrumb -->
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 py-3" aria-label="Breadcrumb">
    <ol class="flex items-center gap-1.5 text-xs text-brand-hydro flex-wrap">
      <li><a href="/" class="hover:underline">Home</a></li>
      <li aria-hidden="true" class="text-gray-300">›</li>
      <li><a href={`/${county.slug}`} class="hover:underline">{county.name}</a></li>
      <li aria-hidden="true" class="text-gray-300">›</li>
      <li><a href={`/${county.slug}/${town.slug}`} class="hover:underline">{town.name}</a></li>
      <li aria-hidden="true" class="text-gray-300">›</li>
      <li class="text-brand-navy font-medium" aria-current="page">{outcode}</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 pb-12 md:pt-16 md:pb-16">
    <div class="max-w-3xl">
      <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-brand-hydro mb-4">
        <span class="w-2 h-2 rounded-full bg-green-400 inline-block animate-pulse" aria-hidden="true"></span>
        Postcode {outcode} — {town.name}, {county.name}
      </p>

      <h1 class="font-display font-extrabold text-5xl sm:text-6xl text-brand-navy leading-tight mb-4">
        Plumber in<br />
        <span class="text-brand-hydro">{outcode}</span>
      </h1>

      <p class="text-lg text-gray-600 max-w-xl mb-8 leading-relaxed">
        One Gas Safe vetted plumber covers the {outcode} postcode area in {town.name}.
        Direct connection — no call centres, no bidding.
      </p>

      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href={`tel:${AREA_PHONE.replace(/\s/g, '')}`}
          class="inline-flex items-center justify-center gap-3 bg-brand-coral text-white
                 font-display font-bold text-xl px-8 py-5 rounded-cta shadow-call
                 hover:bg-[#0099BB] active:scale-[0.98] transition-all"
        >
          <svg width="22" height="22" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3.5 2C3.5 2 2 2.5 2 4.5c0 5 5.5 9.5 10 9.5 2 0 2.5-1.5 2.5-1.5l-2-2-1.5.5S9.5 9.5 8 8C6.5 6.5 6 5 6 5l.5-1.5L5 2z" fill="currentColor"/>
          </svg>
          Call Now — {AREA_PHONE}
        </a>
        <a
          href={`/${county.slug}/${town.slug}#quote-form`}
          class="inline-flex items-center justify-center gap-2 border-2 border-brand-navy
                 text-brand-navy font-semibold text-base px-6 py-4 rounded-cta
                 hover:bg-brand-ice transition-colors"
        >
          Request a Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Location detail strip -->
  <section class="bg-brand-ice py-8 border-y border-brand-hydro/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-sm">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-brand-hydro mb-1">Postcode</dt>
          <dd class="font-display font-bold text-brand-navy text-lg">{outcode}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-brand-hydro mb-1">Town</dt>
          <dd class="font-display font-bold text-brand-navy text-lg">{town.name}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-brand-hydro mb-1">County</dt>
          <dd class="font-display font-bold text-brand-navy text-lg">{county.name}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-brand-hydro mb-1">Response</dt>
          <dd class="font-display font-bold text-brand-navy text-lg">Under 60 min</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Services -->
  <section class="bg-white py-16 border-t border-gray-100" aria-labelledby="services-outcode-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 id="services-outcode-heading" class="font-display font-extrabold text-2xl text-brand-navy mb-2">
        Services in {outcode}
      </h2>
      <p class="text-gray-400 text-sm mb-10">All 23 services covered by your exclusive local partner.</p>

      <div class="mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-hydro mb-4">Plumbing</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {plumbingServices.map((s) => <ServiceCard service={s} variant="grid" />)}
        </div>
      </div>

      <div class="mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-hydro mb-4">Heating</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {heatingServices.map((s) => <ServiceCard service={s} variant="grid" />)}
        </div>
      </div>

      <div class="mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-hydro mb-4">Drains</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {drainServices.map((s) => <ServiceCard service={s} variant="grid" />)}
        </div>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-hydro mb-4">Bathrooms</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {bathroomServices.map((s) => <ServiceCard service={s} variant="grid" />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Link to full town page -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <p class="text-gray-500 mb-4">
      The {outcode} postcode is served by our exclusive {town.name} partner.
      View the full service page for {town.name}:
    </p>
    <a
      href={`/${county.slug}/${town.slug}`}
      class="inline-flex items-center gap-2 text-brand-hydro font-semibold hover:underline"
    >
      Emergency Plumber {town.name} →
    </a>
  </section>

</BaseLayout>
