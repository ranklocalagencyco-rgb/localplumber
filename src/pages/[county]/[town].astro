---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { supabase } from '../../lib/supabase';

// ── Types ─────────────────────────────────────────────────────────────────────

interface TownRow {
  id:         number;
  county_id:  number;
  name:       string;
  slug:       string;
  latitude:   number | null;
  longitude:  number | null;
}

interface CountyRow {
  id:   number;
  name: string;
  slug: string;
}

// ── Area context ──────────────────────────────────────────────────────────────

