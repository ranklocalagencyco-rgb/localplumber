// ── Static paths ──────────────────────────────────────────────────────────────

export async function getStaticPaths() {
  const [townsRes, outcodesRes, territoriesRes] = await Promise.all([
    supabase
      .from('towns')
      .select('id, county_id, name, slug, latitude, longitude, counties(id, name, slug)')
      .order('name'),
    supabase
      .from('outcodes')
      .select('outcode, town_id'),
    supabase
      .from('exclusive_territories')
      .select('outcode, plumber_id, plumbers(phone_routing_number, account_status)'),
  ]);

  const towns = (townsRes.data ?? []) as unknown as Array<TownRow & { counties: CountyRow }>;
  const outcodes = (outcodesRes.data ?? []) as Array<{ outcode: string; town_id: number }>;
  const territories = (territoriesRes.data ?? []) as unknown as Array<{
    outcode:    string;
    plumber_id: string;
    plumbers:   { phone_routing_number: string; account_status: string } | null;
  }>;

  const territoryMap = new Map(territories.map(t => [t.outcode, t.plumbers]));

  const townOutcodes = new Map<number, string[]>();
  for (const oc of outcodes) {
    const list = townOutcodes.get(oc.town_id) ?? [];
    list.push(oc.outcode);
    townOutcodes.set(oc.town_id, list);
  }

  return towns.map(town => {
    const county = town.counties;
    const codes  = townOutcodes.get(town.id) ?? [];

    let isAssigned   = false;
    let partnerPhone: string | null = null;

    for (const code of codes) {
      const plumber = territoryMap.get(code);
      if (plumber?.account_status === 'active') {
        isAssigned   = true;
        partnerPhone = plumber.phone_routing_number;
        break;
      }
    }

    return {
      params: { county: county.slug, town: town.slug },
      props:  { town, county, isAssigned, partnerPhone },
    };
  });
}

// ── Props ─────────────────────────────────────────────────────────────────────

interface Props {
  town:         TownRow;
  county:       CountyRow;
  isAssigned:   boolean;
  partnerPhone: string | null;
}

const { town, county, isAssigned, partnerPhone } = Astro.props as Props;

const context      = areaContext[town.slug as keyof typeof areaContext] ?? null;
const displayPhone = (isAssigned && partnerPhone) ? partnerPhone : '0800 000 0000';
const canonicalUrl = `https://www.localplumber.co.uk/${county.slug}/${town.slug}`;
const pageTitle    = `Plumber in ${town.name} | Local Gas Safe Engineer | LocalPlumber.co.uk`;
const pageDescription = `Gas Safe plumber in ${town.name}. One vetted local engineer per postcode outcode, available 24 hours. Direct contact, no shared leads.`;

// ── JSON-LD ───────────────────────────────────────────────────────────────────

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type':    'Plumber',
  'name':     `Local Plumber ${town.name}`,
  'description': context?.description ?? `Vetted local plumber covering ${town.name}.`,
  'url':      canonicalUrl,
  'telephone': isAssigned ? partnerPhone : '+448000000000',
  'areaServed': {
    '@type': 'City',
    'name':  town.name,
    'containedIn': { '@type': 'AdministrativeArea', 'name': county.name },
  },
  ...(town.latitude ? {
    'geo': {
      '@type':     'GeoCoordinates',
      'latitude':  town.latitude,
      'longitude': town.longitude,
    },
  } : {}),
  'openingHoursSpecification': {
    '@type':      'OpeningHoursSpecification',
    'dayOfWeek':  ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    'opens':      '00:00',
    'closes':     '23:59',
  },
  'priceRange':        '££',
  'paymentAccepted':   'Cash, Credit Card, Bank Transfer',
  'currenciesAccepted':'GBP',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type':    'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home',       'item': 'https://www.localplumber.co.uk' },
    { '@type': 'ListItem', 'position': 2, 'name': county.name,  'item': `https://www.localplumber.co.uk/${county.slug}` },
    { '@type': 'ListItem', 'position': 3, 'name': town.name,    'item': canonicalUrl },
  ],
};

const faqItems = [
  {
    q: `How quickly can I get a plumber in ${town.name}?`,
    a: context?.responseNote ?? `Our ${town.name} partner targets a 60-minute response for emergencies like burst pipes, leaks, and drain blockages. Response times vary by time of day and exact location within ${town.name}.`,
  },
  {
    q: `Are your plumbers in ${town.name} Gas Safe registered?`,
    a: `Yes. Every partner covering ${town.name} is Gas Safe registered and independently vetted before being listed. You can check any engineer's Gas Safe number at the official Gas Safe Register website.`,
  },
  {
    q: `What plumbing services are available in ${town.name}?`,
    a: `The ${town.name} partner covers emergency plumbing, boiler repair and installation, blocked drains, bathroom fitting, central heating, and landlord gas safety certificates. All residential and most commercial jobs are covered.`,
  },
  {
    q: `Do you charge a call-out fee in ${town.name}?`,
    a: `Call-out charges depend on the job type and time of day. Your local ${town.name} engineer will confirm any call-out charge before attending. Emergency out-of-hours rates apply outside standard working hours.`,
  },
  {
    q: `Can I get a same-day plumber in ${town.name}?`,
    a: `For genuine emergencies — burst pipes, leaks, no heating — same-day attendance is the target. For non-urgent jobs like bathroom installations or boiler upgrades, your ${town.name} partner will schedule at a time that suits you.`,
  },
  {
    q: `Is there one plumber exclusively covering ${town.name}?`,
    a: `Yes. We operate a Rule of One — exactly one vetted firm holds the exclusive territory for each postcode area. When you call or submit a form from ${town.name}, your details go directly to that partner. No shared leads, no competing callbacks.`,
  },
  {
    q: `Do your ${town.name} plumbers work weekends and bank holidays?`,
    a: `Yes. The ${town.name} partner operates 24 hours a day, 7 days a week including bank holidays. Out-of-hours rates apply for evenings and weekends.`,
  },
  {
    q: `What should I do while waiting for a plumber in ${town.name}?`,
    a: `If water is leaking, turn off your stop tap first — it's usually under the kitchen sink or where the mains enters the property. For a gas smell, leave the building, don't use switches or flames, and call the National Gas Emergency line on 0800 111 999 before calling a plumber.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type':    'FAQPage',
  'mainEntity': faqItems.map(item => ({
    '@type': 'Question',
    'name':  item.q,
    'acceptedAnswer': { '@type': 'Answer', 'text': item.a },
  })),
};

// ── Service cards ─────────────────────────────────────────────────────────────

const serviceCards = [
  { icon: 'bolt',             name: 'Emergency Plumbing',  desc: '24-hour response for leaks and bursts.',     href: '/services/24-hour-emergency-plumber'    },
  { icon: 'exclamation-circle', name: 'Boiler Repair',     desc: 'Same-day diagnosis and repair.',             href: '/services/emergency-boiler-repair'       },
  { icon: 'funnel',           name: 'Blocked Drains',      desc: 'Jetting and rodding for all drain types.',   href: '/services/blocked-drains'               },
  { icon: 'squares',          name: 'Bathroom Fitting',    desc: 'Full installation and suite replacement.',   href: '/services/bathroom-fitting-installation' },
  { icon: 'fire',             name: 'Central Heating',     desc: 'Radiators, pumps, valves and controls.',     href: '/services/central-heating-service'       },
  { icon: 'circle',           name: 'Gas Safety',          desc: 'CP12 certificates for landlords.',           href: '/services/boiler-repair-service'         },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLdSchemas={[localBusinessSchema, breadcrumbSchema, faqSchema]}
  locationName={town.name}
>

  <!-- ── Section 1: Hero ──────────────────────────────────────────────────── -->
  <section class="bg-white pt-20 pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1.5 text-xs text-brand-hydro">
          <li><a href="/" class="hover:underline">Home</a></li>
          <li aria-hidden="true" class="text-gray-300">›</li>
          <li><a href={`/${county.slug}`} class="hover:underline">{county.name}</a></li>
          <li aria-hidden="true" class="text-gray-300">›</li>
          <li class="text-brand-navy font-medium" aria-current="page">{town.name}</li>
        </ol>
      </nav>

      <!-- Area context eyebrow (unique local knowledge) -->
      {context?.description && (
        <p class="text-gray-500 text-sm max-w-xl mb-4 leading-relaxed">{context.description}</p>
      )}

      <!-- H1 -->
      <h1 class="font-display font-extrabold text-5xl md:text-6xl text-brand-navy leading-tight mb-4">
        Plumber in {town.name}
      </h1>

      <!-- Plumbing note or generic subtext -->
      {context?.plumbingNote ? (
        <p class="text-gray-600 text-lg max-w-xl mb-8 leading-relaxed">{context.plumbingNote}</p>
      ) : (
        <p class="text-gray-600 text-lg max-w-xl mb-8">
          Gas Safe vetted plumber covering {town.name}. Direct call, no switchboard.
        </p>
      )}

      <!-- CTA -->
      {isAssigned ? (
        <div class="flex flex-col sm:flex-row items-start gap-4 flex-wrap">
          <a
            href={`tel:${displayPhone.replace(/\s/g, '')}`}
            class="inline-flex items-center gap-3 bg-brand-coral text-white
                   font-display font-bold text-xl px-8 py-5 rounded-cta shadow-call
                   hover:bg-[#0099BB] active:scale-[0.98] transition-all"
          >
            <svg width="22" height="22" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 2C3.5 2 2 2.5 2 4.5c0 5 5.5 9.5 10 9.5 2 0 2.5-1.5 2.5-1.5l-2-2-1.5.5S9.5 9.5 8 8C6.5 6.5 6 5 6 5l.5-1.5L5 2z" fill="currentColor"/>
            </svg>
            Call Now — {displayPhone}
          </a>
          {context?.responseNote && (
            <span class="inline-flex items-center gap-2 text-sm text-gray-500 border border-gray-200 rounded-full px-4 py-2.5 self-center">
              <span class="w-2 h-2 rounded-full bg-green-400 flex-shrink-0 animate-pulse" aria-hidden="true"></span>
              {context.responseNote}
            </span>
          )}
        </div>
      ) : (
        <div class="max-w-md">
          <p class="text-gray-600 text-sm mb-4">
            Leave your details and we'll confirm whether a local engineer covers {town.name}.
          </p>
          <form method="POST" action="/api/lead-route" class="space-y-3" novalidate>
            <input type="hidden" name="town_slug"   value={town.slug} />
            <input type="hidden" name="county_slug" value={county.slug} />
            <input
              type="text" name="name" placeholder="Your name" required autocomplete="name"
              class="w-full px-4 py-3 bg-brand-ice border border-gray-200 rounded-md
                     text-brand-navy placeholder:text-gray-400 text-sm
                     focus:outline-none focus:ring-2 focus:ring-brand-coral focus:border-transparent"
            />
            <input
              type="tel" name="phone" placeholder="Phone number" required autocomplete="tel"
              class="w-full px-4 py-3 bg-brand-ice border border-gray-200 rounded-md
                     text-brand-navy placeholder:text-gray-400 text-sm
                     focus:outline-none focus:ring-2 focus:ring-brand-coral focus:border-transparent"
            />
            <input
              type="text" name="postcode" placeholder="Postcode" required autocomplete="postal-code"
              class="w-full px-4 py-3 bg-brand-ice border border-gray-200 rounded-md
                     text-brand-navy placeholder:text-gray-400 text-sm uppercase
                     focus:outline-none focus:ring-2 focus:ring-brand-coral focus:border-transparent"
            />
            <button
              type="submit"
              class="w-full bg-brand-coral text-white font-display font-bold text-base
                     py-4 rounded-cta shadow-call hover:bg-[#0099BB] active:scale-[0.98] transition-all"
            >
              Request a Callback
            </button>
          </form>
        </div>
      )}

    </div>
  </section>

  <!-- ── Section 2: Services strip ────────────────────────────────────────── -->
  <section class="bg-white py-10 border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {serviceCards.map(card => (
          <a
            href={card.href}
            class="p-4 bg-white border border-gray-100 rounded-xl text-center
                   hover:border-brand-coral transition-colors group"
          >
            <div class="flex justify-center mb-2">
              <span class="w-9 h-9 rounded-lg bg-brand-ice flex items-center justify-center
                           group-hover:bg-brand-coral/10 transition-colors">
                <Icon name={card.icon} class="w-4 h-4 text-brand-hydro group-hover:text-brand-coral transition-colors" />
              </span>
            </div>
            <p class="text-brand-navy font-semibold text-xs mb-1 group-hover:text-brand-coral transition-colors leading-snug">
              {card.name}
            </p>
            <p class="text-gray-400 text-xs leading-snug">{card.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Section 3: At a Glance ────────────────────────────────────────────── -->
  <section class="bg-brand-ice py-12" aria-labelledby="glance-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 id="glance-heading" class="font-display font-bold text-2xl text-brand-navy mb-6">
        {town.name} — At a Glance
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse" role="table">
          <caption class="sr-only">Local plumbing service information for {town.name}</caption>
          <tbody>
            {[
              { label: 'Coverage Area',    value: `${town.name} and the surrounding postcode outcode` },
              { label: 'Response Target',  value: context?.responseNote ?? '60 minutes for emergency callouts' },
              { label: 'Vetting Standard', value: 'Gas Safe registered, independently verified' },
              { label: 'Call Routing',     value: 'Direct to your local engineer' },
              { label: 'Operating Hours',  value: '24 hours, 7 days including bank holidays' },
            ].map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-brand-ice'}>
                <td class="py-3 px-4 font-medium text-brand-navy border-b border-gray-100 w-1/3 text-sm">
                  {row.label}
                </td>
                <td class="py-3 px-4 text-gray-700 border-b border-gray-100 text-sm">
                  {row.value}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ── Section 4: FAQ ────────────────────────────────────────────────────── -->
  <section class="py-14 max-w-3xl mx-auto px-4 sm:px-6 mb-24 md:mb-0">
    <h2 class="text-2xl font-extrabold text-brand-navy mb-8">
      Questions about plumbers in {town.name}
    </h2>

    <div class="space-y-2">
      {faqItems.map((item) => (
        <details class="bg-white border border-gray-100 rounded-xl group">
          <summary class="flex items-center justify-between px-6 py-5 cursor-pointer list-none">
            <span class="font-display font-semibold text-brand-navy text-base pr-4 leading-snug">{item.q}</span>
            <svg
              width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"
              class="shrink-0 text-brand-hydro transition-transform group-open:rotate-180"
            >
              <path d="M4 7l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <p class="px-6 pb-5 pt-4 text-gray-500 text-sm leading-relaxed border-t border-gray-50">
            {item.a}
          </p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── Section 5: Bottom CTA ─────────────────────────────────────────────── -->
  <section class="bg-brand-navy py-16 mb-24 md:mb-0 text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="font-display font-bold text-3xl text-white mb-4">
        Need a plumber in {town.name}?
      </h2>
      <p class="text-blue-200 text-sm mb-8 max-w-sm mx-auto">
        {isAssigned
          ? `Call directly. No switchboard, no hold music. Straight through to the ${town.name} engineer.`
          : `Leave your details and we will confirm whether we cover ${town.name}.`
        }
      </p>
      <a
        href={`tel:${displayPhone.replace(/\s/g, '')}`}
        class="inline-flex items-center gap-3 bg-brand-coral text-white
               font-display font-bold text-xl px-10 py-5 rounded-cta shadow-call
               hover:bg-[#0099BB] active:scale-[0.98] transition-all"
      >
        <svg width="22" height="22" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3.5 2C3.5 2 2 2.5 2 4.5c0 5 5.5 9.5 10 9.5 2 0 2.5-1.5 2.5-1.5l-2-2-1.5.5S9.5 9.5 8 8C6.5 6.5 6 5 6 5l.5-1.5L5 2z" fill="currentColor"/>
        </svg>
        Call {displayPhone}
      </a>
    </div>
  </section>

</BaseLayout>
